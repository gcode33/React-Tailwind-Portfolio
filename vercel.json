{
  "buildCommand": "npm run build",
  "redirects": [
    {
      "source": "/GeorgeFotabongJr_CV.pdf",
      "destination": "/GeorgeFotabong_Resume.pdf",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!.*\\.).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(assets|fonts)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
